# Comptes i progrés al núvol (Supabase). Copieu aquest fitxer com a .env.local i ompliu-lo.
# Sense aquestes variables la web funciona igual, sense comptes (el progrés es desa al navegador).
# Les trobareu a Supabase → Project Settings → API (URL i «publishable key»; la clau «anon» antiga també serveix).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Pla Pro (preparat, sense activar): vegeu docs/COMPTES.md §9
# VITE_PRO_ENABLED=true
# VITE_PRO_PRICE=4,99 €
